{
  "manifest_version": 3,
  "name": "Subtitle Downloader",
  "description": "Never miss a subtitle again!",
  "version": "0.2",
  "content_scripts": [
    {
      "js": [
        "scripts/FileSaver.min.js",
        "scripts/jsframe.min.js",
        "scripts/content.js",
        "scripts/providers.js",
        "scripts/main.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "permissions": [
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "scripts/service-worker.js"
  },
  "icons": {
    "16": "images/icon.png",
    "32": "images/icon.png",
    "48": "images/icon.png",
    "128": "images/icon.png"
  }
}